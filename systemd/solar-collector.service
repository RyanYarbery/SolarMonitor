[Unit]
Description=EG4 Solar Collector
After=network.target
RequiresMountsFor=/opt/solar-monitor

[Service]
# Type=notify: the collector reports READY and pings the watchdog each cycle,
# so a hung serial read gets the service restarted instead of going stale.
Type=notify
NotifyAccess=main
WatchdogSec=90
User=solar
WorkingDirectory=/opt/solar-monitor
EnvironmentFile=-/etc/solar-monitor.env
# Creates /run/solar-monitor (owned by User=) for the live JSON snapshot.
RuntimeDirectory=solar-monitor
RuntimeDirectoryPreserve=yes
ExecStart=/opt/solar-monitor/.venv/bin/python /opt/solar-monitor/collector.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
