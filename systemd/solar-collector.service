[Unit]
Description=EG4 Solar Collector
After=network.target
RequiresMountsFor=/opt/solar-monitor

[Service]
Type=simple
User=solar
WorkingDirectory=/opt/solar-monitor
EnvironmentFile=-/etc/solar-monitor.env
# Creates /run/solar-monitor (owned by User=) for the live JSON snapshot.
RuntimeDirectory=solar-monitor
RuntimeDirectoryPreserve=yes
ExecStart=/opt/solar-monitor/.venv/bin/python /opt/solar-monitor/collector.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
