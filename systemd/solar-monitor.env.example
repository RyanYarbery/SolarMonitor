# Copy to /etc/solar-monitor.env and adjust. Every variable is optional;
# defaults are in settings.py.
SOLAR_DB_PATH=/opt/solar-monitor/solar_v1.db
SOLAR_SERIAL_PORT=/dev/ttyUSB0
SOLAR_SAMPLE_INTERVAL=10
SOLAR_RAW_RETENTION_DAYS=7
SOLAR_MINUTE_RETENTION_DAYS=365
SOLAR_DASHBOARD_PORT=5000
# Set to 0 only if the inverter firmware emits CRCs that never verify.
SOLAR_SERIAL_STRICT_CRC=1

# Alerts via ntfy (leave empty to disable). Install the ntfy app and
# subscribe to the same topic.
SOLAR_NTFY_URL=
SOLAR_NTFY_TOKEN=
SOLAR_ALERT_COOLDOWN=1800

# Backups: put this on a different device than the database.
SOLAR_BACKUP_DIR=/media/backup/solar-monitor
SOLAR_BACKUP_KEEP=14
# Optional off-site copy, {path} is the .db.gz just written:
# SOLAR_BACKUP_COMMAND=rclone copy {path} remote:solar-backups
SOLAR_BACKUP_COMMAND=

# AC input detection thresholds (volts) for "utility power on/off" alerts.
SOLAR_GRID_ON_VOLTS=100
SOLAR_GRID_OFF_VOLTS=80

# Less common settings, shown with their defaults (see settings.py):
# SOLAR_LIVE_PATH=/run/solar-monitor/latest.json
# SOLAR_SERIAL_BAUD=2400
# SOLAR_SERIAL_TIMEOUT=3.0
# SOLAR_SERIAL_COMMAND_GAP=0.2
# SOLAR_STALE_AFTER=60
# SOLAR_DASHBOARD_HOST=0.0.0.0
# SOLAR_LOW_SOC_CLEAR_MARGIN=5.0
# SOLAR_STALE_ALERT_AFTER=600
# SOLAR_WEATHER_PAST_DAYS=2
